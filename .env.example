# Production settings, stored as /opt/medusa/.env on the server (mode 600).
# infra/scripts/init-env.sh generates this file with random secrets.
# For local development, use apps/*/.env.template instead.

# Storefront is served at DOMAIN, API and admin at api.DOMAIN
DOMAIN=shop.example.com
ACME_EMAIL=
TZ=UTC

# Images. deploy.sh rewrites these two on every release.
BACKEND_IMAGE=medusa-backend:replace-me
STOREFRONT_IMAGE=medusa-storefront:replace-me

# Secrets: use long random values, hex only so they are safe inside URLs
POSTGRES_USER=medusa
POSTGRES_DB=medusa
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=

# Optional: S3-compatible storage. Empty means the local uploads volume.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: transactional email. Empty means notifications go to the log.
SENDGRID_API_KEY=
SENDGRID_FROM=
